#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=mlflow_test
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=00:05:00
#SBATCH --output=slurm_mlflow_test_%A.out

module purge
module load 2022

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH

# ── UPDATE THIS to the output of `hostname` on your login node ────────────────
# Credentials are read automatically from ~/.mlflow/credentials
# ─────────────────────────────────────────────────────────────────────────────

srun python mlflow_quickstart.py
