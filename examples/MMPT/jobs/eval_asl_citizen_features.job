#!/bin/bash
# Evaluate fine-tuned (and baseline) Logos features on ASL-Citizen with BOTH:
#   Eval A — raw video-to-video NN retrieval   (eval_asl_citizen_retrieval.py, SignRep Table 4)
#   Eval B — linear probe                       (eval_asl_citizen_linear_probe.py, SignRep Table 3)
# Run AFTER the ft_asl_citizen_run{1,2,3}_*.job jobs have re-extracted per-run features.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=eval_asl_feats
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

SPLITS=$HOME/ASL_Citizen/splits
mkdir -p runs/asl_ft_eval

# name:feature_dir pairs. 'baseline' = raw Logos features (no fine-tuning) for reference.
declare -A FEATS=(
  [baseline]=$HOME/ASL_Citizen/logos_features
  [run2]=$HOME/ASL_Citizen/logos_features_run2
  [run3]=$HOME/ASL_Citizen/logos_features_run3
  [run1]=$HOME/ASL_Citizen/logos_features_run1
)

for name in baseline run2 run3 run1; do
  dir=${FEATS[$name]}
  if [ ! -d "$dir" ]; then
    echo "== skip $name (no features at $dir) =="
    continue
  fi
  echo ""
  echo "########## $name : $dir ##########"

  echo "--- Eval A (raw NN retrieval) ---"
  python eval_asl_citizen_retrieval.py \
      --feature_name $name --feature_dir $dir --splits_dir $SPLITS \
      --output_json runs/asl_ft_eval/${name}_evalA.json

  echo "--- Eval B (linear probe) ---"
  python eval_asl_citizen_linear_probe.py \
      --feature_name $name --feature_dir $dir --splits_dir $SPLITS \
      --output_json runs/asl_ft_eval/${name}_evalB.json
done

echo ""
echo "All evals done. JSONs in runs/asl_ft_eval/"
