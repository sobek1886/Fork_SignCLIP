#!/bin/bash
# Evaluate fine-tuned (and baseline) Logos features on ASL-Citizen with BOTH:
#   Eval A — raw video-to-video NN retrieval   (eval_asl_citizen_retrieval.py, SignRep Table 4)
#   Eval B — linear probe                       (eval_asl_citizen_linear_probe.py, SignRep Table 3)
# Run AFTER the ft_asl_citizen_run{1,2,3}_*.job jobs have re-extracted per-run features.

#SBATCH --partition=genoa
#SBATCH --job-name=eval_asl_feats
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64
#SBATCH --time=4:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

SPLITS=$HOME/ASL_Citizen/splits
mkdir -p runs/asl_ft_eval

# name:feature_dir pairs. 'baseline*' = raw Logos features (no fine-tuning) for reference.
#   baseline           = OLD extraction (logos_features); only loosely comparable to FT runs.
#   baseline_endanchor = current extract_logos_features.py (end-anchored tail clip so long
#                        ASL-Citizen videos aren't truncated). THIS is the matched reference
#                        for run1/2/3, since they re-extract with the same script.
# Bulky re-extracted features live on scratch-shared; baseline raw features stay in $HOME.
# Headline comparison set. Per-augmentation ablations (run1_glasses/shirt1/signerswap/skin)
# are evaluated separately by jobs/eval_asl_citizen_ablations.job.
declare -A FEATS=(
  [baseline]=$HOME/ASL_Citizen/logos_features
  [baseline_endanchor]=$HOME/ASL_Citizen/logos_features_endanchor
  [baseline_native]=/scratch-shared/psobecki/ASL_Citizen/logos_features_native
  [i3d]=$HOME/ASL_Citizen/i3d_features
  [run2]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run2
  [run3]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run3
  [run1]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1
  # method variants (direct224): two-stage, middle-ground (unfreeze 6), CLS contrastive
  [twostage]=/scratch-shared/psobecki/ASL_Citizen/logos_features_twostage
  [run2_mid]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run2_mid
  [run1_mid]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_mid
  [run1_clscontrast]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_clscontrast
)

for name in baseline baseline_endanchor baseline_native i3d run2 run3 run1 \
            twostage run2_mid run1_mid run1_clscontrast; do
  dir=${FEATS[$name]}
  if [ ! -d "$dir" ]; then
    echo "== skip $name (no features at $dir) =="
    continue
  fi
  echo ""
  echo "########## $name : $dir ##########"

  echo "--- Eval A + B (one MLflow run) ---"
  python eval_asl_citizen_features.py \
      --feature_name $name --feature_dir $dir --splits_dir $SPLITS \
      --mlflow --mlflow_experiment asl-citizen-feature-eval --mlflow_run_name $name \
      --output_json runs/asl_ft_eval/${name}.json
done

echo ""
echo "All evals done. JSONs in runs/asl_ft_eval/"
