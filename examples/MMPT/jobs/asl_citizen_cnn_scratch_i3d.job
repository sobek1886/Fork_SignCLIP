#!/bin/bash
# Stage 1: SignCLIP from scratch on ASL-Citizen with BSL-5K I3D features.
# Produces the baseline checkpoint that asl_citizen_cnn_{i3d_ft,aug_i3d_ft} resume from.
# Uses the ORIGINAL i3d_features (already extracted) — no dependency on the aug extract.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=asl_scratch_i3d
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=12:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_scratch_i3d.yaml --jobtype local_single

python mmpt_cli/predict.py \
    projects/retri/signclip_asl/test_asl_citizen_cnn_scratch_i3d.yaml \
    --quiet
