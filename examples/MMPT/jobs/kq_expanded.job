#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=kq_expanded
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt
module purge; module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
R=/scratch-shared/psobecki/ASL_Citizen
python king_queen_analogy.py \
  --space raw=$R/logos_features_native \
  --space pair_k3=$R/signclip_features_pair_k3 \
  --space pair_k5=$R/signclip_features_pair_k5 \
  --pairs "KING:QUEEN,MAN:WOMAN1,MAN:WOMAN2,BOY:GIRL,FATHER:MOTHER,BROTHER:SISTER,SON:DAUGHTER,UNCLE:AUNT,GRANDFATHER:GRANDMOTHER,HUSBAND:WIFE,NEPHEW:NIECE" \
  --splits_dir $HOME/ASL_Citizen/splits --split train \
  --out_json runs/king_queen_analogy/multi_space_expanded.json \
  --out_png  runs/king_queen_analogy/analogy_expanded.png
echo DONE_KQ_EXPANDED
