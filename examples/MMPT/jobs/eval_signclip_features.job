#!/bin/bash
# Control experiment: evaluate the VIDEO side (pooled_video) of trained SignCLIP models
# with the SAME protocol as raw Logos features —
#   Eval A (raw NN retrieval) + Eval B (linear probe) —
# to see if contrastive video→text training degraded or just re-tasked the Logos features.
# Compare the printed numbers against raw Logos (baseline): DCG 91.69 / Rec@1 81.6.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=eval_signclip_feats
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

SPLITS=$HOME/ASL_Citizen/splits
mkdir -p runs/asl_ft_eval

# name : test-config (checkpoint is read from the config's common_eval.path)
declare -A CFG=(
  [signclip_scratch]=projects/retri/signclip_asl/test_asl_citizen_cnn_scratch_logos_nowd.yaml
  [signclip_aug_ft]=projects/retri/signclip_asl/test_asl_citizen_cnn_aug_logos_ft.yaml
)

for name in signclip_scratch signclip_aug_ft; do
  cfg=${CFG[$name]}
  featdir=/scratch-shared/psobecki/ASL_Citizen/signclip_features_${name}
  echo ""
  echo "########## $name : $cfg ##########"

  echo "--- export pooled_video embeddings ---"
  python export_signclip_features.py --config $cfg --output_dir $featdir --splits train test

  echo "--- Eval A + B (one MLflow run) ---"
  python eval_asl_citizen_features.py \
      --feature_name $name --feature_dir $featdir --splits_dir $SPLITS \
      --mlflow --mlflow_experiment asl-citizen-feature-eval --mlflow_run_name $name \
      --output_json runs/asl_ft_eval/${name}.json
done

echo ""
echo "Done. JSONs in runs/asl_ft_eval/  (compare to baseline raw Logos: DCG 91.69 / Rec@1 81.6)"
