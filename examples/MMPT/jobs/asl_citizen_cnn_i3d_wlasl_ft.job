#!/bin/bash
# No-aug FT control on WLASL-ft I3D features — resumes the April scratch
# baseline (asl_citizen_cnn_scratch_wlasl_nowd). Corrected replacement for the
# June asl_citizen_cnn_i3d_ft.job (which ran on BSL-5K features).

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=i3d_wlasl_ft
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=24:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_i3d_wlasl_ft.yaml --jobtype local_single

python mmpt_cli/predict.py \
    projects/retri/signclip_asl/test_asl_citizen_cnn_i3d_wlasl_ft.yaml \
    --quiet
