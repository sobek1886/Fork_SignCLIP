#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=asl_sgd_sweep_real
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=24:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

# SGD LR sweep on original data only. Three 15-epoch ranking runs, train-only.
# Compare valid_loss across the three runs in MLflow (signclip-cnn), then set the
# winning lr in asl_citizen_cnn_logos_ft_sgd.yaml and launch the full 50-epoch
# run via jobs/asl_citizen_cnn_logos_ft_sgd.job.

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_logos_ft_sgd_lr5e4.yaml --jobtype local_single
srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_logos_ft_sgd_lr1e3.yaml --jobtype local_single
srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_logos_ft_sgd_lr5e3.yaml --jobtype local_single
