#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=cnn_finetune
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=24:00:00
#SBATCH --output=jobs/output/slurm_cnn_train_%A.txt

# Prerequisites (run once before submitting this job):
#   python prepare_cnn_checkpoint.py \
#       --input  runs/retri_v1_1/baseline_temporal/checkpoint_best.pt \
#       --output runs/retri_v1_1/baseline_temporal_cnn_ready.pt

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python locallaunch.py \
    projects/retri/signclip_asl/asl_citizen_cnn_finetune.yaml \
    --jobtype local_single
