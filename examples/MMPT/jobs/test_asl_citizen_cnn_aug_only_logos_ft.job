#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=test_asl_aug_only_ft
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=02:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

# Standalone eval of asl_citizen_cnn_aug_only_logos_ft (checkpoint_best.pt = the
# val-loss minimum, before the overfitting upturn). Logs test metrics to MLflow.

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

python mmpt_cli/predict.py \
    projects/retri/signclip_asl/test_asl_citizen_cnn_aug_only_logos_ft.yaml \
    --quiet
