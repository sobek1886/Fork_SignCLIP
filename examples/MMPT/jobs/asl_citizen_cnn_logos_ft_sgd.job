#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=asl_sgd_real_ft
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=24:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

# Full 50-epoch SGD fine-tune on original data only + eval.
# Set the winning lr in asl_citizen_cnn_logos_ft_sgd.yaml (from the sweep) first.

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python locallaunch.py projects/retri/signclip_asl/asl_citizen_cnn_logos_ft_sgd.yaml --jobtype local_single

python mmpt_cli/predict.py \
    projects/retri/signclip_asl/test_asl_citizen_cnn_logos_ft_sgd.yaml \
    --quiet
