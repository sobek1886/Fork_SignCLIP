#!/bin/bash
#SBATCH --partition=genoa
#SBATCH --job-name=form_dose_all
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:45:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt
module purge; module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
R=/scratch-shared/psobecki/ASL_Citizen
python form_dose.py \
  --space raw=$R/logos_features_native \
  --space consistency=$R/logos_features_run1 \
  --space ce=$R/logos_features_run2 \
  --space aug=$R/logos_features_run3 \
  --space sdda=$R/logos_features_run_sdda \
  --space signclip_scratch=$R/signclip_features_signclip_scratch \
  --space signclip_ft=$R/signclip_features_signclip_ft \
  --space signclip_aug_ft=$R/signclip_features_signclip_aug_ft \
  --space pair_k3=$R/signclip_features_pair_k3 \
  --space pair_k5=$R/signclip_features_pair_k5
