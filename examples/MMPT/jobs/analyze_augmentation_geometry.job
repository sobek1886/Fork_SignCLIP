#!/bin/bash
# S1+S3: augmentation displacement-direction analysis + counterfactual
# confusion test (see analyze_augmentation_geometry.py docstring).
# Runs on every space that contains BOTH original and _variant .npy files;
# spaces with originals only are skipped automatically. Frozen Logos
# (logos_features, where the SignCLIP-side aug features live) is the
# guaranteed space; i3d_wlasl_features joins once
# extract_i3d_wlasl_features_aug.job has run.
# CPU-only; run on genoa.

#SBATCH --partition=genoa
#SBATCH --job-name=aug_geometry
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

mkdir -p runs/aug_geometry

python analyze_augmentation_geometry.py \
    --space frozen_logos=/home/psobecki/ASL_Citizen/logos_features \
    --space i3d_wlasl=/home/psobecki/ASL_Citizen/i3d_wlasl_features \
    --splits_dir /home/psobecki/ASL_Citizen/splits \
    --split train \
    --out_json runs/aug_geometry/aug_geometry.json

echo "Done."
