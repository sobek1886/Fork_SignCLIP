#!/bin/bash
# Embedding-space t-SNE/silhouette comparison across training conditions:
# raw frozen Logos, backbone-FT (CE / aug-as-data / consistency), and the
# SignCLIP variants (scratch / ft / aug-ft / SupCon-on-pairs K3 & K5).
# Companion to jobs/probe_backbone_ft_l2.job and
# jobs/probe_signclip_variants_l2.job — same spaces, qualitative view.
# SignCLIP spaces must be exported first (jobs/king_queen_analogy.job stage 1
# exports them; this job reuses those dirs and skips missing ones).

#SBATCH --partition=genoa
#SBATCH --job-name=embedding_viz
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=02:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

ROOT=/scratch-shared/psobecki/ASL_Citizen
SPACE_ARGS=""
declare -A CANDIDATES=(
  [raw]=$ROOT/logos_features_native
  [ft_ce]=$ROOT/logos_features_run2
  [ft_augdata]=$ROOT/logos_features_run3
  [ft_consistency]=$ROOT/logos_features_run1
  [signclip_scratch]=$ROOT/signclip_features_signclip_scratch
  [signclip_aug_ft]=$ROOT/signclip_features_signclip_aug_ft
  [pair_k3]=$ROOT/signclip_features_pair_k3
  [pair_k5]=$ROOT/signclip_features_pair_k5
)
for name in raw ft_ce ft_augdata ft_consistency signclip_scratch signclip_aug_ft pair_k3 pair_k5; do
  dir=${CANDIDATES[$name]}
  if [ -d "$dir" ]; then
    SPACE_ARGS="$SPACE_ARGS --space $name=$dir"
  else
    echo "SKIP $name — $dir not found"
  fi
done

python visualize_embedding_spaces.py \
    $SPACE_ARGS \
    --splits_dir $HOME/ASL_Citizen/splits \
    --split train --n_glosses 12 --n_per_gloss 20 \
    --out_dir runs/embedding_viz

echo "Done."
