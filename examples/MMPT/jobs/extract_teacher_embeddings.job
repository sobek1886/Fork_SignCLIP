#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=teacher_embed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=1:00:00
#SBATCH --output=jobs/output/slurm_teacher_embed_%A.txt

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python extract_teacher_embeddings.py \
    --config   projects/retri/signclip_asl/asl_citizen_cnn_scratch_logos.yaml \
    --checkpoint $HOME/ASL_Citizen/asl_citizen_cnn_scratch_logos/checkpoint_best.pt \
    --logos_dir  $HOME/ASL_Citizen/logos_features \
    --splits_dir $HOME/ASL_Citizen/splits \
    --output_dir $HOME/ASL_Citizen/logos_teacher_embeddings \
    --batch_size 256
