#!/bin/bash
# Preprocessing comparison: 3 modes × {frozen original ckpt, baseline FT (CE, no aug)}.
# Eval A (raw NN retrieval) + Eval B (linear probe), one MLflow run each in asl-citizen-feature-eval.
# Skips any feature dir not yet produced. Run after the extract/FT jobs finish.
#   frozen:  baseline_native (logos_native) | baseline_endanchor (direct224) | baseline_letterbox
#   FT(CE):  run2 (logos_native)            | run2_direct224                 | run2_letterbox224

#SBATCH --partition=rome
#SBATCH --job-name=eval_asl_preproc
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64
#SBATCH --time=2:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

SPLITS=$HOME/ASL_Citizen/splits
mkdir -p runs/asl_ft_eval

declare -A FEATS=(
  [baseline_native]=/scratch-shared/psobecki/ASL_Citizen/logos_features_native
  [baseline_endanchor]=$HOME/ASL_Citizen/logos_features_endanchor
  [baseline_letterbox]=/scratch-shared/psobecki/ASL_Citizen/logos_features_letterbox
  [run2]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run2
  [run2_direct224]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run2_direct224
  [run2_letterbox224]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run2_letterbox224
)

for name in baseline_native baseline_endanchor baseline_letterbox run2 run2_direct224 run2_letterbox224; do
  dir=${FEATS[$name]}
  if [ ! -d "$dir" ]; then
    echo "== skip $name (no features at $dir) =="
    continue
  fi
  echo ""
  echo "########## $name : $dir ##########"
  python eval_asl_citizen_features.py \
      --feature_name $name --feature_dir $dir --splits_dir $SPLITS --load_workers 64 \
      --mlflow --mlflow_experiment asl-citizen-feature-eval --mlflow_run_name $name \
      --output_json runs/asl_ft_eval/${name}.json
done

echo ""
echo "Preprocessing comparison done. JSONs in runs/asl_ft_eval/"
