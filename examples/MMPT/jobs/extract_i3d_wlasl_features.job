#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=i3d_wlasl_extract
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --time=04:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH

srun python extract_asl_citizen_i3d_features.py \
    --video_dir   /home/psobecki/ASL_Citizen/videos \
    --output_dir  /home/psobecki/ASL_Citizen/i3d_wlasl_features \
    --i3d_weights /home/psobecki/I3D_wlasl.tar \
    --num_classes 2000 \
    --workers     4 \
    --batch_size  128
