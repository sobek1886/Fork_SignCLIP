#!/bin/bash
# Extract WLASL-fine-tuned I3D features for the AUGMENTED ASL-Citizen frame dirs.
# CORRECTED version of extract_i3d_features_aug.job (2026-07-12): the June batch
# extracted with BSL-5K weights (and the script's num_classes default of 2000,
# which matches WLASL, not BSL-5K's 5383) — producing features incomparable to
# the reported I3D baseline row, which uses I3D_wlasl.tar features
# (i3d_wlasl_features, per the April switch in commit ae3eb0ac).
# Writes asl_citizen_{id}_{variant}.npy alongside the originals in
# i3d_wlasl_features, so the corrected aug/pair configs
# (asl_citizen_cnn_aug_i3d_wlasl_ft.yaml, asl_citizen_cnn_appearance_invariant_i3d.yaml)
# find them. Stride-2 variants (signer_swap/skin) get the frame-rate fix.
# JPGs live on scratch-shared (slow small-file reads) → many CPU workers.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=i3d_wlasl_extract_aug
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python extract_asl_citizen_i3d_features_aug.py \
    --aug_root    /scratch-shared/psobecki/ASL_Citizen/augmented_frames \
    --output_dir  /home/psobecki/ASL_Citizen/i3d_wlasl_features \
    --i3d_weights /home/psobecki/I3D_wlasl.tar \
    --num_classes 2000 \
    --workers     16 \
    --batch_size  128
