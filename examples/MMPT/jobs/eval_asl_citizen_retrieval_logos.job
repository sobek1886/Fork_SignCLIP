#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=asl_retri_logos
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=0:30:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025

cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

FEATURE_DIR=/home/psobecki/ASL_Citizen/logos_features
SPLITS_DIR=/home/psobecki/ASL_Citizen/splits
OUTPUT_JSON=runs/eval_asl_citizen_retrieval_logos.json

python eval_asl_citizen_retrieval.py \
    --feature_name logos \
    --feature_dir  $FEATURE_DIR \
    --splits_dir   $SPLITS_DIR \
    --output_json  $OUTPUT_JSON
