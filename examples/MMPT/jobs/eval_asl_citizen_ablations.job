#!/bin/bash
# Evaluate the per-augmentation ABLATION runs (isolated single-variant consistency)
# with BOTH Eval A (raw NN retrieval) and Eval B (linear probe), one MLflow run each
# in the asl-citizen-feature-eval experiment.
# Companion to jobs/eval_asl_citizen_features.job (headline set: baseline*/run2/run3/run1).
# Run after the ft_asl_citizen_run1_consistency_{glasses,shirt1,signerswap,skin}.job re-extract.

#SBATCH --partition=genoa
#SBATCH --job-name=eval_asl_ablations
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=64
#SBATCH --time=4:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

SPLITS=$HOME/ASL_Citizen/splits
mkdir -p runs/asl_ft_eval

declare -A FEATS=(
  [run1_glasses]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_glasses
  [run1_shirt1]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_shirt1
  [run1_signerswap]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_signerswap
  [run1_skin]=/scratch-shared/psobecki/ASL_Citizen/logos_features_run1_skin
)

for name in run1_glasses run1_shirt1 run1_signerswap run1_skin; do
  dir=${FEATS[$name]}
  if [ ! -d "$dir" ]; then
    echo "== skip $name (no features at $dir) =="
    continue
  fi
  echo ""
  echo "########## $name : $dir ##########"

  echo "--- Eval A + B (one MLflow run) ---"
  python eval_asl_citizen_features.py \
      --feature_name $name --feature_dir $dir --splits_dir $SPLITS \
      --mlflow --mlflow_experiment asl-citizen-feature-eval --mlflow_run_name $name \
      --output_json runs/asl_ft_eval/${name}.json
done

echo ""
echo "All ablation evals done. JSONs in runs/asl_ft_eval/"
