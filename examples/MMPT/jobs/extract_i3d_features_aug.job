#!/bin/bash
# Extract BSL-5K I3D features for the AUGMENTED ASL-Citizen frame dirs.
# Writes asl_citizen_{id}_{variant}.npy alongside the originals in i3d_features, so
# asl_citizen_cnn_aug_i3d_ft.yaml (splits_aug, vfeat_dir=i3d_features) finds them.
# Same weights (bsl5k) + recipe as extract_asl_citizen_i3d_features.py → comparable
# with the originals. Stride-2 variants (signer_swap/skin) get the frame-rate fix.
# JPGs live on scratch-shared (slow small-file reads) → many CPU workers.

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=i3d_extract_aug
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=jobs/output/slurm_%x_%A.txt

module purge
module load 2025
cd $HOME/Fork_SignCLIP/examples/MMPT
source .venv/bin/activate
export PYTHONPATH=$HOME/Fork_SignCLIP:$PYTHONPATH
export PATH="$HOME/Fork_SignCLIP/examples/MMPT/.venv/bin:$PATH"

srun python extract_asl_citizen_i3d_features_aug.py \
    --aug_root    /scratch-shared/psobecki/ASL_Citizen/augmented_frames \
    --output_dir  /home/psobecki/ASL_Citizen/i3d_features \
    --i3d_weights /home/psobecki/bsl5k.pth.tar \
    --workers     16 \
    --batch_size  128
